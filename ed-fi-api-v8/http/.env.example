# Copy to http/.env (git-ignored) for the VS Code REST Client .http files in this folder, which
# read these through {{$dotenv NAME}}. Never commit the filled-in copy.

# "key" and "secret" from ../.runtime/bootstrap-credentials.json (smoke.http, edorgs.http)
DMS_BOOTSTRAP_KEY=
DMS_BOOTSTRAP_SECRET=

# CONFIGURATION_SERVICE_ADMIN_CLIENT_SECRET from ../.env (claimset-test.http, warehouse-claimset.http)
CONFIGURATION_SERVICE_ADMIN_CLIENT_SECRET=
