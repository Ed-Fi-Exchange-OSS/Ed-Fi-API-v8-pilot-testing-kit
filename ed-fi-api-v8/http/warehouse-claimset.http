# Creates and tests client credentials using the warehouse claimset.
# Reads CONFIGURATION_SERVICE_ADMIN_CLIENT_SECRET from the git-ignored http/.env (copy http/.env.example); the value
# is the CONFIGURATION_SERVICE_ADMIN_CLIENT_SECRET line in the kit's own .env.

@baseUrlApi = https://localhost/api
@baseUrlConfig = https://localhost/config
# @dataApiBaseUrl is the root for resource requests (for example https://localhost/api/data), read
# from the unauthenticated Discovery request below at $.urls.dataManagementApi. Send the "discovery"
# request before the data request; REST Client errors on {{discovery.response...}} until it has been
# sent once in this session.
@dataApiBaseUrl = {{discovery.response.body.$.urls.dataManagementApi}}
@cmsAdminSecret = {{$dotenv CONFIGURATION_SERVICE_ADMIN_CLIENT_SECRET}}

### Authenticate with bootstrap credentials
# @name cmsToken
POST {{baseUrlConfig}}/connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials&client_id=PilotKitAdmin&client_secret={{cmsAdminSecret}}&scope=edfi_admin_api/full_access

### Lookup the existing vendor Id so that we can add a new application to it.
# @name vendorId
GET {{baseUrlConfig}}/v3/vendors?company=Pilot+Kit+Bootstrap+(ADMIN)
Authorization: Bearer {{cmsToken.response.body.access_token}}

### Create a new application and credentials
# @name application
POST {{baseUrlConfig}}/v3/applications
Authorization: Bearer {{cmsToken.response.body.access_token}}
Content-Type: application/json

{
    "applicationName": "Data Warehouse",
    "vendorId": {{vendorId.response.body.0.id}},
    "claimSetName": "DataWarehouse",
    "educationOrganizationIds": [
        99
    ],
    "dataStoreIds": [
        1
    ],
    "enabled": true
}

### Discovery (no authentication): find the data API root
# @name discovery
GET {{baseUrlApi}}

### Authenticate with Ed-Fi API v8 using warehouse claimset client
# @name warehouseToken
POST {{baseUrlApi}}/oauth/token
Authorization: Basic {{application.response.body.key}} {{application.response.body.secret}}
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials
&client_id={{application.response.body.key}}
&client_secret={{application.response.body.secret}}

### Get all students, with total count header
GET {{dataApiBaseUrl}}/ed-fi/students?totalCount=true
Authorization: Bearer {{warehouseToken.response.body.access_token}}

### Retrieve the apiClientId to use below in resetting the credentials
# @name apiClientId
GET {{baseUrlConfig}}/v3/apiClients?applicationId={{application.response.body.id}}
Authorization: Bearer {{cmsToken.response.body.access_token}}

### Reset credentials so that you can copy and use elsewhere
PUT {{baseUrlConfig}}/v3/apiClients/{{apiClientId.response.body.$[0].id}}/reset-credential
Authorization: Bearer {{cmsToken.response.body.access_token}}
